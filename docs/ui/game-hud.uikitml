<style>
  .game-hud-container {
    align-items: flex-start;
    padding: 2;
    width: 66;
    display: flex;
    flex-direction: column;
    background-color: #09090b;
    border-color: #27272a;
    border-width: 0.15;
    border-radius: 3;
  }

  .game-hud-heading {
    font-size: 3;
    font-weight: medium;
    color: #fafafa;
    text-align: left;
    margin-bottom: 1;
  }

  .game-hud-row {
    font-size: 2;
    font-weight: medium;
    color: #fafafa;
    text-align: left;
    margin-top: 0.3;
  }

  .game-hud-status {
    font-size: 1.6;
    color: #fbbf24;
    text-align: left;
    margin-top: 1;
  }

  .game-hud-button {
    width: 100%;
    padding: 1.5;
    margin-top: 1.5;
    background-color: #fafafa;
    color: #09090b;
    border-radius: 1.5;
    border-width: 0.1;
    border-color: #e4e4e7;
    font-size: 2.2;
    font-weight: medium;
    text-align: center;
    cursor: pointer;
  }

  .game-hud-button-secondary {
    width: 100%;
    padding: 1.2;
    margin-top: 1;
    background-color: #27272a;
    color: #fafafa;
    border-radius: 1.5;
    border-width: 0.1;
    border-color: #52525b;
    font-size: 2;
    font-weight: medium;
    text-align: center;
    cursor: pointer;
  }
</style>
<div class="game-hud-container">
  <span class="game-hud-heading">Junkyard Freeze</span>
  <span id="hud-points" class="game-hud-row">POINTS  0</span>
  <span id="hud-parts" class="game-hud-row">PARTS  0 / 6</span>
  <span id="hud-gun" class="game-hud-row">GUN Mk I | SHOTS 2/2 | 5s freeze | UPG 5 PTS</span>
  <span id="hud-status" class="game-hud-status">Find the car parts!</span>
  <button id="upgrade-button" class="game-hud-button">UPGRADE GUN</button>
  <button id="restart-button" class="game-hud-button-secondary">RESTART RUN</button>
</div>
